---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---
<Layout title={post.data.title} description={post.data.excerpt}>
  <section style="max-width:720px;">
    <div class="kicker">{post.data.date.toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' })}</div>
    <h1 style="font-family:'Fraunces',serif;font-weight:500;font-size:clamp(28px,4vw,42px);margin:0 0 32px;line-height:1.15;">
      {post.data.title}
    </h1>
    <div class="article-body">
      <Content />
    </div>
    <p style="margin-top:56px;"><a class="blog-more" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/blog/`}>← Alle Beiträge</a></p>
  </section>
</Layout>

<style>
  .article-body { font-size: 17px; line-height: 1.75; color: var(--ink-soft); }
  .article-body :global(p) { margin: 0 0 22px; }
  .article-body :global(h2) { font-family: 'Fraunces', serif; color: var(--ink); font-size: 26px; margin: 40px 0 18px; }
  .article-body :global(strong) { color: var(--ink); }
</style>
